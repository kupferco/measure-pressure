{
  "expo": {
    "name": "Measure Pressure",
    "slug": "measure-pressure",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "measurepressure",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.kupfer.measurepressure",
      "infoPlist": {
        "NSCameraUsageDescription": "Measure Pressure uses the camera to photograph your blood pressure monitor so the reading can be entered for you."
      }
    },
    "android": {
      "package": "co.kupfer.measurepressure",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Measure Pressure uses the camera to photograph your blood pressure monitor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
