# Copy to .env and adjust. .env is gitignored.
#
# Read by Node's own .env parser, not the shell - so values with spaces or angle
# brackets need no quoting or escaping.

APP_ENV=local                 # local | staging | prod
PORT=8080
LOG_LEVEL=info                # set to warn if request logs bury the login code

# One database behind every environment, by design.
#
#   Throwaway Docker one:  postgresql://measure:measure@localhost:55432/measure_pressure?sslmode=disable
#   Cloud SQL via proxy:   postgresql://USER:PASS@127.0.0.1:5432/measure_pressure?sslmode=disable
#   Cloud SQL from Cloud Run: postgresql://USER:PASS@/measure_pressure?host=/cloudsql/PROJECT:REGION:INSTANCE
#
# sslmode=disable is needed for the two local forms: the connection is already on
# the loopback interface (the Cloud SQL Auth Proxy encrypts the hop itself), and
# Atlas insists on SSL unless told otherwise.
DATABASE_URL=postgresql://measure:measure@localhost:55432/measure_pressure?sslmode=disable

# Where the app is served from. Used for the link in the login email, and for CORS
# in staging and prod. Locally any origin is allowed, so a phone on the same
# network can open the web build without its address being listed here.
WEB_ORIGIN=http://localhost:8081
EXTRA_ORIGINS=

SESSION_TTL_DAYS=7            # sliding: every use pushes the expiry back
MAGIC_LINK_TTL_MINUTES=15

# console prints the login code to the API log - no mail account needed locally.
# Switch to resend (and set the key) when you want real email.
MAIL_TRANSPORT=console
MAIL_FROM=Measure Pressure <onboarding@resend.dev>
# RESEND_API_KEY=re_...

# Omron photos. Leave GCS_BUCKET unset locally to keep them in ./.uploads instead.
# GCS_BUCKET=measure-pressure-scans
GOOGLE_CLOUD_PROJECT=lv-notas
