# Copy to .env and fill in. .env is gitignored.

APP_ENV=local                 # local | staging | prod
PORT=8080
LOG_LEVEL=info

# One database behind every environment, by design.
# Cloud SQL over the Auth Proxy:  postgresql://USER:PASS@127.0.0.1:5432/measure_pressure
# Cloud SQL from Cloud Run:       postgresql://USER:PASS@/measure_pressure?host=/cloudsql/PROJECT:REGION:INSTANCE
# The throwaway Docker one:       postgresql://measure:measure@localhost:55432/measure_pressure
DATABASE_URL=postgresql://measure:measure@localhost:55432/measure_pressure

# Where the web build is served from. Used for CORS and the link in the login email.
WEB_ORIGIN=http://localhost:8081
# Expo dev server, staging preview, anything else that needs to call the API.
EXTRA_ORIGINS=http://localhost:19006

SESSION_TTL_DAYS=60
MAGIC_LINK_TTL_MINUTES=15

# console prints the login code to the server log - no mail account needed locally.
MAIL_TRANSPORT=console
MAIL_FROM=Measure Pressure <onboarding@resend.dev>
# RESEND_API_KEY=re_...

# Omron photos. Leave GCS_BUCKET unset locally to keep them in ./.uploads instead.
# GCS_BUCKET=measure-pressure-scans
GOOGLE_CLOUD_PROJECT=lv-notas
