# Copy this to .env and fill in the blanks. .env is gitignored; this file is not,
# so never put real passwords here.
#
# Values are read as plain text - no quotes needed, even for URLs. The only
# character to watch is '#', which starts a comment.

APP_ENV=local
PORT=8080
LOG_LEVEL=info                # set to warn if the request logs get noisy

# ---------------------------------------------------------------- database
#
# Paste the connection string Neon shows you on the project dashboard. Whichever
# of the two it offers is fine - the schema commands sort out the rest.
DATABASE_URL=

# ---------------------------------------------------------------- app

WEB_ORIGIN=http://localhost:8081
EXTRA_ORIGINS=

SESSION_TTL_DAYS=7            # you stay signed in as long as you keep using it
MAGIC_LINK_TTL_MINUTES=15
READING_SESSION_MINUTES=10    # readings this close together count as one sitting

# 'console' prints your sign-in code to the API log, so local development needs no
# email account. Switch to 'resend' and set the key to send real email.
MAIL_TRANSPORT=console
MAIL_FROM=Measure Pressure <onboarding@resend.dev>

# Paste your Resend key here. Leaving MAIL_TRANSPORT as 'console' keeps local
# sign-in codes in the API log; the key is what lets the DEPLOYED app send real
# email, and it gets copied into Secret Manager from here.
RESEND_API_KEY=

# Where photos go. Left unset, they are written to ./.uploads on this machine.
# GCS_BUCKET=measure-pressure-app-scans
GOOGLE_CLOUD_PROJECT=measure-pressure-app
